github=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
public_repo=https://github.com/YourUsername/YourRepo
private_repo=https://github.com/YourUsername/YourRepo_private
type=main
claude_name_on_commit=false

# Git commit rules:
# claude_name_on_commit=false means DO NOT add "Co-Authored-By: Claude" in commit messages on GitHub.
# Commits should appear as developer-authored only.

# Instance Lock — Google Doc ON/OFF switch
# Create a Google Doc, share it with "Anyone with the link can view"
# Write one line per system: HOME=ON / OFFICE=OFF
# Bot reads this doc every N seconds to check if this system is ON or OFF
# If OFF -> bot shuts down instantly with Telegram notification
lock_doc=https://docs.google.com/document/d/YOUR_GOOGLE_DOC_ID/edit
lock_check_interval=5

# Systems — name=ip1,ip2
# Add your systems here. Name must match what you write in the Google Doc.
# Find your IPs: ipconfig (Windows) or ip addr (Linux)
# You can add as many systems as needed.
system_HOME=192.168.1.100,192.168.1.101
system_OFFICE=10.0.0.50,10.0.0.51
# system_LAPTOP=192.168.0.200

# CRITICAL NOTE:
# NEVER delete, remove, or overwrite any file from this project under any circumstance.
# Git orphan branch checkouts WILL wipe untracked/gitignored files from disk — DO NOT use them.
